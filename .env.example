# ==============================================================================
# Health Delivery System - Environment Configuration Template
# Duplicate this file as '.env' and update the values for your environment.
# ==============================================================================

# Application Environment (production | development)
APP_ENV=production
APP_NAME="Health Delivery System - Bacolod"
APP_URL=http://localhost/Health-Delivery-System-Latest

# Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=health_delivery_system

# Brevo SMS Gateway API Key (replace with your transactional SMS key)
BREVO_API_KEY=your_brevo_api_key_here

# System Logging (logs written to /logs directory)
LOG_LEVEL=info
