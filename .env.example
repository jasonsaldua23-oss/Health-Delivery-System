# ==============================================================================
# OPTION 3: Direct SMTP Email Configuration (Gmail, Hostinger, Outlook, or Brevo SMTP)
# If configured, SMTP is prioritized for sending OTP and transactional emails without IP whitelist restrictions.
# ==============================================================================
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@bsns.online
# SMTP_PASS=your_email_password
# SMTP_SECURE=ssl
# MAIL_FROM_ADDRESS=no-reply@bsns.online
# MAIL_FROM_NAME="Bacolod Health Delivery System"

# For Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_gmail@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_SECURE=tls
# MAIL_FROM_ADDRESS=your_gmail@gmail.com
# MAIL_FROM_NAME="Bacolod Health Delivery System"

# System Logging (logs written to /logs directory)
LOG_LEVEL=info

